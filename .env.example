APP_ENV=development

# Providers
OCR_PROVIDER=azure_vision_ocr
AI_PROVIDER=ai_native
OCR_ALLOW_FAST_FALLBACK=false

# Azure Vision OCR
AZURE_VISION_ENDPOINT=https://<your-vision-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=your_vision_key_here
AZURE_VISION_API_VERSION=2023-10-01

# Local development storage
STORAGE_PROVIDER=local
BARREL_STORAGE_DIR=/tmp/barrel_storage_local

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string
AZURE_STORAGE_CONTAINER=barrel-review

# Authentication
BARREL_DEMO_USERNAME=evaluator
BARREL_DEMO_PASSWORD=fallback-demo-password-123
BARREL_REVIEW_TOKEN=fallback-review-token-123

# AI Native Parser
AI_NATIVE_ENABLED=true

# The user must provide their own Azure OpenAI endpoint and key here
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=barrel-ai-native-parser
AZURE_OPENAI_API_VERSION=2025-01-01-preview
