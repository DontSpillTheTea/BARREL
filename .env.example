APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OCR_PROVIDER=paddleocr
OCR_DEEP_PROVIDER=paddleocr
OCR_DEEP_OCR_ENABLED=true
OCR_WARMUP_ON_STARTUP=true
OCR_REQUIRE_READY_FOR_ANALYSIS=true
OCR_ALLOW_FAST_FALLBACK=false
OCR_DEEP_PROVIDER_TIMEOUT_SECONDS=60
OCR_AUTO_DEEP_SCAN_ENABLED=true
OCR_PROVIDER_TIMEOUT_SECONDS=4
OCR_READY_TIMEOUT_SECONDS=60
OCR_LOCAL_CONFIDENCE_THRESHOLD=65
OCR_MIN_TEXT_LENGTH=80
AI_PROVIDER=none
SECRET_PROVIDER=env

AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

MAX_UPLOAD_MB=25
TARGET_LABEL_PROCESSING_SECONDS=5
